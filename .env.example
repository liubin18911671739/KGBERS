# 复制为 .env 并按需修改。.env 不会被提交(见 .gitignore)。

# Flask
FLASK_CONFIG=development
SECRET_KEY=change-me

# 关系数据库(SQLite);留空则使用 data/sqlite/app.db
# DATABASE_URL=sqlite:///data/sqlite/app.db
# TEST_DATABASE_URL=sqlite:///data/sqlite/test.db

# Neo4j 图数据库
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# 课程数据源(逗号分隔的 URL 或本地 JSON/CSV 路径;留空使用内置样例)
# 示例:真实 Coursera 课程公开数据集(GitHub,约 890 门课)
# COURSE_DATA_URLS=https://raw.githubusercontent.com/Siddharth1698/Coursera-Course-Dataset/master/UCoursera_Courses.csv
# 示例:Class Central MOOC 汇总数据集(分号分隔 CSV)
# COURSE_DATA_URLS=https://raw.githubusercontent.com/skillwiki/these_mooc/master/data/classcentral.csv
